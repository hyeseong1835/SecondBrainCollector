<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>secondbrain-collector</AssemblyName>
    <RootNamespace>LifeLog.Collector.Windows</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LifeLog.Core\LifeLog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
    <!-- 디스코드 녹음(discord-output: WASAPI 루프백, discord-bot: 봇 음성 수신). 버전은 HearingAid와 같다 -->
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.11" />
    <PackageReference Include="libdave" Version="1.1.1.7" />
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="DSharpPlus.Natives.Opus" Version="1.6.1.34" />
  </ItemGroup>

</Project>
