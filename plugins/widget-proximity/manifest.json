{
  "type": "renderer",
  "id": "widget-proximity",
  "version": "1.1.0",
  "name": "폰↔노트북 거리",
  "description": "폰↔노트북 BLE 신호 세기(RSSI) 색 띠(빨강=멀다 → 초록=가깝다 연속 그라데이션)와 RSSI 그래프(중앙값 선, 최소~최대 띠). 거리 구간은 없다",
  "min_host_version": 1,
  "platforms": [
    "windows",
    "android"
  ],
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "win-phone-link/rssi@1"
  ],
  "settings": [
    {
      "key": "ref_rssi_1m",
      "type": "number",
      "default": -53,
      "label": "1m 기준 RSSI(\"약 몇 m\" 추정용, 수집기 설정과 맞춘다)"
    },
    {
      "key": "path_loss_n",
      "type": "number",
      "default": 2.5,
      "label": "경로 손실 지수(\"약 몇 m\" 추정용)"
    }
  ]
}
