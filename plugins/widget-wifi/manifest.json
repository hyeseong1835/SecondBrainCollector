{
  "type": "renderer",
  "id": "widget-wifi",
  "version": "1.1.0",
  "name": "와이파이",
  "description": "휴대폰 와이파이 연결: SSID별 연결 시간, 하루 타임라인, 연결 목록(시각·SSID·대역·평균 신호·인터넷 확인·AP 이동)",
  "min_host_version": 1,
  "runtimes": {
    "webview": "index.html"
  },
  "slot": "card",
  "inputs": [
    "phone-network/wifi@1",
    "phone-network/signal@1"
  ],
  "settings": [
    {
      "key": "ssids",
      "type": "number",
      "default": 8,
      "label": "SSID 막대 개수"
    },
    {
      "key": "limit",
      "type": "number",
      "default": 30,
      "label": "목록 개수"
    },
    {
      "key": "device",
      "type": "string",
      "default": "",
      "label": "기기 (비우면 전부)"
    }
  ]
}
