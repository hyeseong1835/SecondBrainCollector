{
  "type": "collector",
  "id": "win-laptop-mic",
  "version": "1.0.0",
  "name": "노트북 마이크 녹음 (Windows)",
  "min_host_version": 1,
  "platforms": [
    "windows"
  ],
  "runtimes": {
    "js": "main.js"
  },
  "capabilities": [
    {
      "id": "event:laptop_mic",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "recording",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "file": "text",
        "bytes": "bigint",
        "sha256": "text",
        "codec": "text",
        "duration_ms": "bigint",
        "mean_db": "double precision",
        "peak_db": "double precision",
        "floor_db": "double precision"
      },
      "label": "file",
      "identity": [
        "file"
      ]
    }
  ],
  "description": "노트북 마이크를 디스코드 통화와 상관없이 상시 녹음한다. 소리가 있는 구간만 파일로 남긴다(내 목소리 기준 녹음).",
  "settings": [
    {
      "key": "input_device",
      "type": "string",
      "default": "",
      "label": "녹음할 입력 장치",
      "description": "마이크 장치 ID 또는 이름 일부. 비우면 Windows 기본 통신 입력 장치를 쓰고, 기본 장치가 바뀌면 따라간다.",
      "x-picker": "audio-input"
    }
  ]
}