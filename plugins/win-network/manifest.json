{
  "type": "collector",
  "id": "win-network",
  "version": "1.0.0",
  "name": "네트워크 (Windows)",
  "min_host_version": 1,
  "platforms": [
    "windows"
  ],
  "runtimes": {
    "js": "main.js"
  },
  "capabilities": [
    {
      "id": "event:network",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "connection",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "kind": "text",
        "net_key": "text",
        "name": "text",
        "ssid": "text",
        "gateway_mac": "text",
        "adapter": "text"
      },
      "label": "name",
      "identity": ["net_key"]
    }
  ],
  "description": "노트북이 붙어 있던 네트워크(와이파이 SSID, 유선은 게이트웨이 MAC)를 구간으로 기록한다. 네트워크마다 폰↔노트북 거리(RSSI)를 이름 붙은 구간(예: 책상 앞·침대·방 밖)으로 나눠 보이는 데 쓴다. 구간은 설정 › 네트워크별 거리 구간에서 정한다.",
  "settings": [
    {
      "key": "zones",
      "type": "string",
      "default": "",
      "label": "네트워크별 거리 구간",
      "x-ui": "network-zones",
      "description": "JSON. 설정 › 수집기·소스 › 네트워크별 거리 구간 화면에서 고친다(직접 고치지 않아도 된다). 수집기는 읽지 않고 화면(웹·데스크톱)만 쓴다."
    }
  ]
}
