{
  "type": "collector",
  "id": "phone-network",
  "version": "1.0.2",
  "name": "네트워크 (안드로이드)",
  "min_host_version": 1,
  "platforms": [
    "android"
  ],
  "runtimes": {
    "js": "main.js"
  },
  "capabilities": [
    {
      "id": "event:network",
      "required": true
    },
    {
      "id": "timer",
      "required": true
    }
  ],
  "privacy": [
    {
      "key": "store_bssid",
      "type": "boolean",
      "default": true,
      "label": "BSSID(공유기 MAC) 저장 (끄면 SSID만. BSSID는 위치를 알아낼 수 있다)"
    }
  ],
  "outputs": [
    {
      "name": "wifi",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "network": "text",
        "ssid": "text",
        "bssid": "text",
        "frequency_mhz": "integer",
        "band": "text",
        "standard": "text",
        "security": "text",
        "link_speed_mbps": "integer",
        "validated": "boolean",
        "metered": "boolean",
        "ip": "text",
        "gateway": "text",
        "roams": "integer"
      },
      "label": "ssid",
      "identity": [
        "network"
      ],
      "index": [
        "ssid"
      ]
    },
    {
      "name": "cellular",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "network": "text",
        "carrier": "text",
        "sim_slot": "integer",
        "rat": "text",
        "roaming": "boolean",
        "validated": "boolean",
        "metered": "boolean",
        "ip": "text"
      },
      "label": "rat",
      "identity": [
        "network"
      ]
    },
    {
      "name": "default",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "transport": "text",
        "network": "text",
        "label": "text"
      },
      "label": "transport",
      "identity": [
        "transport"
      ]
    },
    {
      "name": "signal",
      "kind": "span",
      "schema_version": 1,
      "columns": {
        "connection_id": "text",
        "transport": "text",
        "level": "integer",
        "dbm_min": "integer",
        "dbm_max": "integer"
      },
      "label": "level",
      "identity": [
        "transport"
      ],
      "index": [
        "connection_id"
      ]
    }
  ]
}
